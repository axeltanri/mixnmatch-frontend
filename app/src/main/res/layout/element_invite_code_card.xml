<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginVertical="15dp"
    app:contentPadding="15dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E2E8F0"
    tools:showIn="@layout/activity_group_activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:contentPadding="5dp"
            app:cardBackgroundColor="#EEF2FF"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/baseline_link_24"
                app:tint="#4F46E5"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/caption_TextSize"
                android:text="Invite Code"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/subHeader_TextSize"
                android:textStyle="bold"
                android:text="ABC-101"/>
        </LinearLayout>



        <com.google.android.material.card.MaterialCardView
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#EEF2FF"
            app:strokeWidth="0dp"
            app:contentPaddingTop="7dp"
            app:contentPaddingBottom="7dp"
            app:contentPaddingLeft="10dp"
            app:contentPaddingRight="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="3dp"
                    android:src="@drawable/baseline_ios_share_24"
                    app:tint="#4F46E5"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textColor="#4F46E5"/>
            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


</com.google.android.material.card.MaterialCardView>